                    "encoding": {
                        "y": {
                            "field": "previous_sum",
                            "type": "quantitative",
                            "axis": {"title": "Reuse Water (ML)", "grid": false}
                        },
                        "y2": {"field": "sum"},
                        "color": {
                            "condition": [
                                {
                                    "test": "datum.year === 'Start' || datum.year === 'End'",
                                    "value": "#d6d6d6"
                                },
                                {
                                    "test": "datum.amount < 0",
                                    "value": "#04c4b1"
                                }
                            ], "value": "#30acfc"
                        },
                        "tooltip": [
                            {"field": "sector", "type": "nominal", "title": "Sector" },
                            {"field": "year", "type": "nominal", "title": "Year" },
                            {"field": "amount", "type": "quantitative", "title": "Change (ML)" },
                            {"field": "sum", "type": "quantitative", "title": "Water Reuse (ML)" }
                        ]
                    }
                },
                {
                    "mark": {
                        "type": "rule",
                        "color": "black",
                        "strokeWidth": 2,
                        "xOffset": -22.5,
                        "x2Offset": 22.5
                    },
                    "encoding": {
                        "x2": {"field": "lead"},
                        "y": {"field": "sum", "type": "quantitative"}
                    }
                },
                {
                    "mark": {
                        "type": "text",
                        "baseline": "middle",
                        "fontSize": 11,
                        "dy": {"expr": "datum.year === '2023' ? -12 : (datum.amount >= 0 ? -0 : 0)"}
                    },
                    "encoding": {
                        "x": {"field": "year"},
                        "y": {"field": "center", "type": "quantitative"},
                        "text": {"field": "text_amount"},
                        "color": {
                            "condition": [
                                {"test": "datum.year === '2023'", "value": "black"}
                            ], "value": "white"
                        }
                    }
                },
                {
                    "mark": {
                        "type": "text",
                        "fontWeight": "bold",
                        "baseline": "middle",
                        "fontSize": 14,
                        "dy": {"expr": "datum.amount >= 0 ? -8 : 8"},
                        "color": "black"
                    },
                    "encoding": {
                        "x": {"field": "year"},
                        "y": {"field": "sum", "type": "quantitative"},
                        "text": {"field": "sum", "type": "quantitative"}
                    }
                },
                {
                    "mark": {
                        "type": "rule",
                        "color": "black",
                        "strokeWidth": 1
                    },
                    "encoding": {
                        "color": {"value": "black"},
                        "x": {"value": 230},
                        "x2": {"value": 200},
                        "y": {"value": 65},
                        "y2": {"value": 90}
                    }
                },
                {
                    "mark": {
                        "type": "text",
                        "align": "left",
                        "color": "black",
                        "lineBreak": "\n",
                        "dx": 10,
                        "dy": -10,
                        "fontSize": 12
                    },
                    "encoding": {
                        "color": {"value": "black"},
                        "x": {"value": 140},
                        "y": {"value": 110},
                        "text": {
                            "value": "There is a sharp \ndecline wiping out \nover 15000 ML of \nreuse water by 2023, \nfollowed by a \nsubstantial surge \nin 2024"
                        }
                    }
                }
            ]
        }
    ]
}