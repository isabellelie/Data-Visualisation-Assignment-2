                {"window": [{"op": "lead", "field": "year", "as": "lead"}]},
                {"calculate": "datum.lead === null ? datum.year: datum.lead", "as": "lead"},
                {"calculate": "datum.year === 'End' ? 0:datum.sum - datum.amount", "as": "previous_sum"},
                {"calculate": "(datum.sum + datum.previous_sum) / 2", "as": "center"},
                {"calculate": "datum.year === 'Start' || datum.year === 'End' ? '' : (datum.amount > 0 ? '+' : '') + datum.amount", "as": "text_amount"}
            ],
            "encoding": {
